# Copy with `make env`, which fills in random secrets. Never commit .env.

POSTGRES_PASSWORD=
OSTRAKA_SECRET_KEY=

# The address people open Ostraka at; used in links in emails and notifications
OSTRAKA_PUBLIC_URL=http://127.0.0.1:24747
# Named on report covers as "Prepared for"; leave empty to omit
OSTRAKA_ORGANISATION=

# none | ollama | anthropic. Ostraka meets its reporting standard with none.
OSTRAKA_AI_PROVIDER=none

# Email for notifications (optional): smtp or graph
OSTRAKA_MAIL_TRANSPORT=smtp

# Microsoft Graph: an Entra app registration sending as one mailbox (README: Email through Microsoft Graph)
OSTRAKA_GRAPH_TENANT_ID=
OSTRAKA_GRAPH_CLIENT_ID=
OSTRAKA_GRAPH_CLIENT_SECRET=
OSTRAKA_GRAPH_SENDER=

# SMTP: STARTTLS on 587, or OSTRAKA_SMTP_TLS=ssl on 465
OSTRAKA_SMTP_HOST=
OSTRAKA_SMTP_PORT=587
OSTRAKA_SMTP_TLS=starttls
OSTRAKA_SMTP_USERNAME=
OSTRAKA_SMTP_PASSWORD=
OSTRAKA_SMTP_FROM=
